<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows plain-http traffic only to the Android emulator's host-loopback
  alias (10.0.2.2), so a local FastAPI backend on the dev machine is
  reachable during native testing. Meaningless outside an emulator, and
  never matches a real deployed (https) backend, so this is safe to ship.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
